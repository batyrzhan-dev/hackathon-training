# Copy to .env locally if needed. Never commit real credentials.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional hybrid semantic matching; disabled when EMBEDDING_PROVIDER is unset.
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
